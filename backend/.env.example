ADMIN_PASSWORD=admin123456

# AI translation can be configured in the administrator web page.
# Environment variables remain supported as a deployment alternative.
TRANSLATION_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
TRANSLATION_TIMEOUT_SECONDS=90
TRANSLATION_MAX_RETRIES=2

# OCR uses a local Tesseract installation when available in Windows PATH.

# Optional Windows OCR executable path. The installer fills this automatically.
TESSERACT_CMD=

# Payment / Stripe
PAYMENT_TEST_MODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=

# V24 PayPal Checkout (recommended for Vietnam merchant onboarding)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Set to your public website URL in production
PUBLIC_BASE_URL=http://localhost:8000

# Paddle Billing (preferred third-party checkout)
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CHECKOUT_URL=
PADDLE_PRICE_MAP={}

# Authentication
AUTH_SECRET=replace-with-a-long-random-secret
SESSION_TTL_SECONDS=2592000

# Password reset email (production)
PASSWORD_RESET_TTL_SECONDS=900
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_NAME=Document Automation AI
PASSWORD_RESET_DEV_CODE_ENABLED=false

# Registration and anti-abuse
GOOGLE_CLIENT_ID=
FREE_SIGNUP_CREDITS=500
REGISTRATION_IP_WINDOW_SECONDS=86400
REGISTRATION_IP_MAX_ACCOUNTS=3

# Google sign-in and registration email verification
EMAIL_VERIFICATION_TTL_SECONDS=900
EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_FAIL_OPEN=true

# V41 Enterprise Security (P0)
SECURITY_ENABLED=true
SECURITY_TRUST_PROXY_HEADERS=true
SECURITY_STRICT_STARTUP=false
SECURITY_REQUEST_BODY_LIMIT_MB=512
SECURITY_GENERAL_RPM=240
SECURITY_AUTH_RPM=20
SECURITY_LOGIN_RPM=10
SECURITY_UPLOAD_RPM=60
SECURITY_PAYMENT_RPM=30
SECURITY_LOGIN_MAX_FAILURES=5
SECURITY_LOGIN_WINDOW_SECONDS=900
SECURITY_LOGIN_LOCK_SECONDS=900
SECURITY_WEBHOOK_REPLAY_TTL_SECONDS=86400
SECURITY_AUDIT_LOG_MAX_MB=20
SECURITY_ARCHIVE_MAX_MEMBERS=1000
SECURITY_ARCHIVE_MAX_UNCOMPRESSED_MB=1024
SECURITY_ARCHIVE_MAX_RATIO=200
SECURITY_LIMITER_MAX_BUCKETS=50000
SECURITY_LOGIN_GUARD_MAX_ENTRIES=50000

# V41.1 Edge security / Cloudflare integration
# Keep false until the production hostname is fully proxied by Cloudflare.
SECURITY_REQUIRE_CLOUDFLARE=false
SECURITY_BOT_BLOCK_ENABLED=true
# Comma-separated IPs or CIDRs. Example: 203.0.113.9,198.51.100.0/24
SECURITY_BLOCKED_IPS=
# Leave empty for public access. When set, every other IP is denied.
SECURITY_ALLOWED_IPS=
# ISO 3166-1 alpha-2 country codes from Cloudflare CF-IPCountry.
SECURITY_BLOCKED_COUNTRIES=
SECURITY_ALLOWED_COUNTRIES=

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://document-automation-ai.vercel.app
