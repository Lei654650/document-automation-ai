# Render/cloud template. Create these variables in the platform dashboard.
APP_VERSION=45.0.0
APP_ENV=production
CLOUD_MODE=true
APP_DATA_DIR=/data
PUBLIC_BASE_URL=
CORS_ORIGINS=
MAX_FILE_SIZE_MB=100
LOG_LEVEL=INFO

AUTH_SECRET=
OWNER_EMAIL=
ADMIN_PASSWORD=
SESSION_TTL_SECONDS=2592000
FREE_SIGNUP_CREDITS=500
REGISTRATION_IP_WINDOW_SECONDS=86400
REGISTRATION_IP_MAX_ACCOUNTS=3

EMAIL_VERIFICATION_DEV_CODE_ENABLED=false
PASSWORD_RESET_DEV_CODE_ENABLED=false
EMAIL_VERIFICATION_TTL_SECONDS=900
EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
PASSWORD_RESET_TTL_SECONDS=900
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_WINDOW_SECONDS=900
PASSWORD_RESET_MAX_SUCCESSFUL_SENDS=5

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Document Automation AI
SMTP_USE_TLS=true
SMTP_USE_SSL=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

TRANSLATION_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
TRANSLATION_TIMEOUT_SECONDS=35
TRANSLATION_MAX_RETRIES=0
TRANSLATION_GLOBAL_CONCURRENCY=2
TRANSLATION_FILE_AI_BUDGET_SECONDS=55

PAYMENT_TEST_MODE=false
PAYPAL_MODE=sandbox
PAYPAL_LIVE_ENABLED=false
PAYPAL_LIVE_REQUIRED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_TEST_PRICE_CENTS=0
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=

PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CHECKOUT_URL=
PADDLE_PRICE_MAP={}
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

ENFORCE_CREDITS=true
PROCESSING_MODE=inline
JOB_STALE_SECONDS=300
TESSERACT_CMD=
