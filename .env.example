# Document Automation AI V45.0.0 - safe local template
APP_VERSION=45.0.0
APP_ENV=development
CLOUD_MODE=false
APP_DATA_DIR=.runtime
PUBLIC_BASE_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MAX_FILE_SIZE_MB=100
LOG_LEVEL=INFO

# Authentication. Generate fresh values; do not commit a populated .env.
AUTH_SECRET=
OWNER_EMAIL=
ADMIN_PASSWORD=
SESSION_TTL_SECONDS=2592000
FREE_SIGNUP_CREDITS=500
REGISTRATION_IP_WINDOW_SECONDS=86400
REGISTRATION_IP_MAX_ACCOUNTS=3

# Local-only one-time codes. The backend also requires APP_ENV=development and CLOUD_MODE=false.
EMAIL_VERIFICATION_DEV_CODE_ENABLED=true
PASSWORD_RESET_DEV_CODE_ENABLED=true
EMAIL_VERIFICATION_TTL_SECONDS=900
EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
PASSWORD_RESET_TTL_SECONDS=900
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_WINDOW_SECONDS=900
PASSWORD_RESET_MAX_SUCCESSFUL_SENDS=5

# SMTP. Leave blank to use the local-only development code mode above.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Document Automation AI
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Google Identity Services
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# AI providers. TRANSLATION_PROVIDER selects the active provider; both profiles may be prepared.
TRANSLATION_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
TRANSLATION_TIMEOUT_SECONDS=35
TRANSLATION_MAX_RETRIES=0
TRANSLATION_GLOBAL_CONCURRENCY=2
TRANSLATION_FILE_AI_BUDGET_SECONDS=55

# Payments. Sandbox is the only default; Live requires two explicit variables.
PAYMENT_TEST_MODE=false
PAYPAL_MODE=sandbox
PAYPAL_LIVE_ENABLED=false
PAYPAL_LIVE_REQUIRED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_TEST_PRICE_CENTS=0
PAYMENT_SUCCESS_URL=http://127.0.0.1:5173/?payment=paypal-return
PAYMENT_CANCEL_URL=http://127.0.0.1:5173/?payment=cancelled

# Optional payment providers already present in the backend
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CHECKOUT_URL=
PADDLE_PRICE_MAP={}
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Processing and OCR
ENFORCE_CREDITS=true
PROCESSING_MODE=
JOB_STALE_SECONDS=300
TESSERACT_CMD=
DAI_7ZIP_PATH=
DAI_WINRAR_PATH=
DAI_UNRAR_PATH=

# Frontend build. Leave blank for the local Vite proxy or same-origin deployment.
VITE_API_BASE_URL=
