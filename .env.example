APP_VERSION=15.0.0
CLOUD_MODE=false

# Payment / Stripe
PAYMENT_TEST_MODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=

# Paddle Billing (preferred third-party checkout)
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CHECKOUT_URL=
PADDLE_PRICE_MAP={}

# Authentication
AUTH_SECRET=replace-with-a-long-random-secret
SESSION_TTL_SECONDS=2592000

# V30.2 PayPal Checkout
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=

# Registration and anti-abuse
GOOGLE_CLIENT_ID=
FREE_SIGNUP_CREDITS=500
REGISTRATION_IP_WINDOW_SECONDS=86400
REGISTRATION_IP_MAX_ACCOUNTS=3

# Google sign-in and registration email verification
EMAIL_VERIFICATION_TTL_SECONDS=900
EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
